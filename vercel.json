{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/calendar",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/backoffice/profiles",
      "destination": "/backoffice/users",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/backoffice/index",
      "destination": "/backoffice",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?op=home"
    },
    {
      "source": "/interview/:category(productmanagement|productux)/:slug",
      "destination": "/api/site?op=person&category=:category&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site?op=sitemap"
    },
    {
      "source": "/indexnow.txt",
      "destination": "/api/site?op=indexnow-key"
    },
    {
      "source": "/api/apply",
      "destination": "/api/site?op=apply"
    },
    {
      "source": "/api/recommend",
      "destination": "/api/site?op=recommend"
    },
    {
      "source": "/api/candidates",
      "destination": "/api/site?op=candidates"
    },
    {
      "source": "/api/interview",
      "destination": "/api/site?op=interview"
    },
    {
      "source": "/api/profile-photo",
      "destination": "/api/site?op=profile-photo"
    },
    {
      "source": "/api/interview-photo",
      "destination": "/api/site?op=interview-photo"
    },
    {
      "source": "/api/my-interview",
      "destination": "/api/site?op=my-interview"
    },
    {
      "source": "/api/published",
      "destination": "/api/site?op=published"
    },
    {
      "source": "/api/question-bank",
      "destination": "/api/site?op=question-bank"
    },
    {
      "source": "/api/member-me",
      "destination": "/api/site?op=member-me"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/site?op=subscribe"
    },
    {
      "source": "/api/member-logout",
      "destination": "/api/site?op=member-logout"
    },
    {
      "source": "/api/backoffice-me",
      "destination": "/api/site?op=backoffice-me"
    },
    {
      "source": "/api/backoffice-users",
      "destination": "/api/site?op=backoffice-users"
    },
    {
      "source": "/api/backoffice-logout",
      "destination": "/api/site?op=backoffice-logout"
    },
    {
      "source": "/api/member-profile",
      "destination": "/api/site?op=member-profile"
    },
    {
      "source": "/api/member-network",
      "destination": "/api/site?op=member-network"
    },
    {
      "source": "/api/member-map",
      "destination": "/api/site?op=member-map"
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "{assets/*.js,assets/*.css,person.html,api/_lib/templates/*.html}"
    }
  },
  "headers": [
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(jpg|jpeg|png|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
